<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 계정 백업·동기화(docs/SERVER_SYNC_HANDOFF.md), 앱 내 업데이트(AppUpdate.kt): GitHub 릴리스 확인·APK 내려받기 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱 내 업데이트(AppUpdate.kt): 시스템 패키지 설치기 열기 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trex_kotlin"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
            configChanges: 회전 시 Activity 재생성을 막는다. 자세 세션은 카메라·코치·접지선 추정이
            모두 화면 상태에 살아 있어, 재생성되면 진행 중이던 세트가 끊기고 접지선이 리셋된다.
            (세션 진행도는 rememberSaveable 이라 살아남지만 세트 내부 상태는 아니다.)
            Compose 는 LocalConfiguration 으로 방향 변화를 받으므로 UI 는 정상 갱신되고,
            카메라 회전값·중력축은 PostureLive/PostureLabScreen 에서 configuration 을 키로 다시 계산한다.
            windowSoftInputMode=adjustResize: 키보드가 올라오면 앱 화면 높이가 준다(스펙 §117) — Android 12 이하(가장자리까지 그리지 않는 창)는
            창이 줄고, 15 이상은 키보드 여백이 앱 루트의 safeDrawing 으로 온다. 어느 쪽이든 적는 칸이 키보드에 가리지 않는다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Trex_kotlin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Apple 웹 로그인(Android, 설계 docs/superpowers/specs/2026-10-29-apple-sign-in-design.md §9)이 돌아오는 문.
            서버 콜백이 intent://callback?…#Intent;scheme=trexapple;package=…;end 로 연다. 화면 없이 결과만 넘기고 닫힌다.
            아무 웹 페이지나 이 주소를 열 수 있지만, 앱은 자기가 보낸 state 일 때만 받는다(sync/AppleWebSignIn.kt).
        -->
        <activity
            android:name=".AppleSignInCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trexapple" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- 자세 세트 로그(JSONL) 공유 내보내기·업데이트 APK 설치용 (posture/PostureSetLogExport.kt, AppUpdate.kt, res/xml/file_paths.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
