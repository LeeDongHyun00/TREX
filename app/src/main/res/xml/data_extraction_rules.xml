<?xml version="1.0" encoding="utf-8"?>
<!-- 기기 Keystore 키는 이전되지 않는다. 키 없는 암호문 복원으로 기록이 덮이는 것을 막는다.
     서버 동기화 범위는 유지하며 로컬 전용 기록은 앱 삭제/기기 변경 전에 별도 내보내기가 필요하다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="food_memory.tsv" />
        <exclude domain="file" path="food_memory.tsv.tmp" />
        <exclude domain="file" path="food_memory.tsv.aes" />
        <exclude domain="file" path="food_memory.tsv.aes.writing" />
        <exclude domain="file" path="food_memory.tsv.tmp.aes" />
        <exclude domain="file" path="food_memory.tsv.tmp.aes.writing" />
        <exclude domain="file" path="posture_baseline.tsv" />
        <exclude domain="file" path="posture_baseline.tsv.aes" />
        <exclude domain="file" path="posture_baseline.tsv.aes.writing" />
        <exclude domain="file" path="posture_logs/" />
        <exclude domain="external" path="posture_logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="food_memory.tsv" />
        <exclude domain="file" path="food_memory.tsv.tmp" />
        <exclude domain="file" path="food_memory.tsv.aes" />
        <exclude domain="file" path="food_memory.tsv.aes.writing" />
        <exclude domain="file" path="food_memory.tsv.tmp.aes" />
        <exclude domain="file" path="food_memory.tsv.tmp.aes.writing" />
        <exclude domain="file" path="posture_baseline.tsv" />
        <exclude domain="file" path="posture_baseline.tsv.aes" />
        <exclude domain="file" path="posture_baseline.tsv.aes.writing" />
        <exclude domain="file" path="posture_logs/" />
        <exclude domain="external" path="posture_logs/" />
    </device-transfer>
</data-extraction-rules>
