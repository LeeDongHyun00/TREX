<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
           The local store holds what onboarding collected: goal, schedule, and body metrics
           (gender, height, weight, age), plus the workout log. Copying that to a cloud account
           would send off the device the one thing this app never sends anywhere.

           The whole directory, not the file: a save writes through a sibling .tmp holding an
           identical copy, and a path entry matches by exact name, so naming only the file would
           leave a crash-orphaned temp copy backed up.
        -->
        <exclude
            domain="file"
            path="trex" />
    </cloud-backup>
    <!--
       Device-to-device transfer is deliberately left unrestricted: it moves data straight to the
       user's replacement phone without a server in the middle, so a phone upgrade keeps the log
       rather than silently starting over. The asymmetry with cloud-backup above is the point.
    -->
    <device-transfer />
</data-extraction-rules>