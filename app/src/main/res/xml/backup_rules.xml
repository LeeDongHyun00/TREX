<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
       The local store holds what onboarding collected: goal, schedule, and body metrics
       (gender, height, weight, age), plus the workout log. This app keeps everything on the
       device, so letting auto-backup copy that to a cloud account would quietly break the one
       promise it makes. Excluded here for pre-31 devices and in data_extraction_rules.xml for 31+.

       The whole directory, not the file: a save writes through a sibling .tmp holding an identical
       copy, and a path entry matches by exact name, so naming only the file would leave a
       crash-orphaned temp copy backed up.
    -->
    <exclude
        domain="file"
        path="trex" />
</full-backup-content>