# EC2 의 ~/trex/.env 로 복사해 값을 채운다. 이 예시 파일 말고 .env 는 절대 커밋하지 않는다.

# RDS 엔드포인트 — RDS 콘솔 "연결 & 보안" 탭. DB 이름은 RDS 만들 때 "초기 데이터베이스 이름"(trex).
DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/trex
DB_USERNAME=trex
DB_PASSWORD=<RDS 마스터 비밀번호>

# JWT 서명 키 — 32바이트 이상 무작위. 만들기: openssl rand -base64 48
# 바꾸면 이미 로그인한 앱은 모두 다시 로그인해야 한다.
JWT_SECRET=<무작위 문자열>

# 구글 콘솔 "웹 애플리케이션" 클라이언트 ID(비밀값 아님). 쉼표로 여러 개.
GOOGLE_CLIENT_IDS=12194757714-foefivjlqn4n3g5iqdsgqlqst12ejbpi.apps.googleusercontent.com

# Apple 로그인(docs/SERVER_SYNC_HANDOFF.md 10절). 번들 ID 는 비밀값 아님 — 이것만 있으면 로그인이 된다.
APPLE_CLIENT_IDS=com.leedonghyun.trex.ios
# 아래 셋은 동현님 Apple 개발자 계정에서 받는 비밀값(공개 저장소·채팅 금지). 비면 탈퇴 때 Apple 연결 끊기만 건너뛴다.
# <…> 는 자리 표시 — 꺾쇠까지 지우고 값만. .p8 은 파일 내용 전체를 한 줄로(줄바꿈은 \n 두 글자) 넣는다.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Android Apple 로그인(웹 흐름) — 동현님 개발자 계정에 만든 Services ID 와 그 Return URL(이 서버 주소 + /api/auth/oauth/apple/callback).
# Return URL 은 앱 gradle.properties 의 trex.appleRedirectUri 와 글자까지 같아야 한다. 비면 Android 의 Apple 로그인이 401.
APPLE_WEB_CLIENT_ID=com.leedonghyun.trex.signin
APPLE_WEB_REDIRECT_URI=https://trex-api.duckdns.org/api/auth/oauth/apple/callback

# 커뮤니티(2026-10-29, docs/SERVER_SYNC_HANDOFF.md 9절)
# 사진 버킷 — 비공개 S3(시드니). 비우면 서버가 뜨지 않는다. 자격 증명은 EC2 인스턴스 역할(키를 여기 넣지 않는다).
# <…> 는 자리 표시 — 꺾쇠까지 지우고 이름만(예: COMMUNITY_S3_BUCKET=trex-community-k7m2qp).
COMMUNITY_S3_BUCKET=trex-community-<임의 6자>
# 관리자 loginId(쉼표). 내 loginId 는 로그인 토큰으로 GET /api/auth/me 의 loginId(google_<숫자>).
COMMUNITY_ADMIN_LOGIN_IDS=
# 새 신고를 알릴 디스코드 웹후크 — 비밀값(아는 사람은 누구나 채널에 글을 쓴다). 비우면 알리지 않는다.
COMMUNITY_REPORT_WEBHOOK_URL=

# 서버 주소(DuckDNS 등). 앱 local.properties 의 trex.apiBaseUrl 은 https://<이 값>
TREX_DOMAIN=<이름>.duckdns.org

# 공유 링크 웹 페이지의 iPhone "앱 설치하기" — App Store 주소(출시 전 비움, 비밀값 아님)
SHARE_IOS_INSTALL_URL=
