        <mxCell id="caddy" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;:80 · :443&lt;br&gt;HTTPS 인증서 자동&lt;br&gt;(Let's Encrypt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;" vertex="1" parent="docker">
          <mxGeometry x="15" y="65" width="150" height="90" as="geometry" />
